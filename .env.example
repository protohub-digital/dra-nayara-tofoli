# URL canônica do site (sem barra final)
# Use o domínio Cloudflare Pages até ter um domínio próprio
PUBLIC_SITE_URL=https://dra-nayara-tofoli.pages.dev

# WhatsApp — apenas números com DDI
PUBLIC_WHATSAPP_NUMBER=5527998440261

# Instagram — URL completa
PUBLIC_INSTAGRAM_URL=https://instagram.com/dra.nayaratofoli

# Agendamento (WhatsApp direto)
PUBLIC_BOOKING_URL=https://wa.me/5527998440261
PUBLIC_CALENDLY_URL=

# Google Maps
PUBLIC_GOOGLE_MAPS_URL=https://www.google.com/maps/place/Dra.+Nayara+T%C3%B3foli/@-19.5376678,-40.6304641,17z

# Endpoint do formulário de contato (Formspree, etc.)
PUBLIC_FORM_ENDPOINT=

# ─────────────────────────────────────────────
# ANALYTICS & TRACKING
# ─────────────────────────────────────────────

# Google Tag Manager (ex: GTM-XXXXXXX)
PUBLIC_GTM_ID=

# Google Analytics 4 (ex: G-XXXXXXXXXX)
PUBLIC_GA4_ID=

# Meta Pixel / Facebook Pixel (ex: 1234567890)
PUBLIC_META_PIXEL_ID=

# Google Ads Conversion ID (ex: AW-XXXXXXXXX)
PUBLIC_GOOGLE_ADS_ID=

# TikTok Pixel (opcional)
PUBLIC_TIKTOK_PIXEL_ID=
