---
import { SITE } from "@data/site";

interface Props {
  title?: string;
  subtitle?: string;
  provider?: "calendly" | "google" | "whatsapp";
}

const {
  title = "Agende seu horário",
  subtitle = "Escolha o dia e horário que melhor se encaixa na sua rotina. Atendimento personalizado e pontual.",
  provider = "whatsapp",
} = Astro.props;

const calendlyUrl = SITE.bookingUrl;
const whatsappUrl = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`;
---

<section
  id="agendar"
  class="section-padding"
  style="background: linear-gradient(135deg, var(--color-nude-50) 0%, var(--color-cream-200) 100%);"
  aria-labelledby="booking-heading"
>
  <div class="container-site">
    <div class="max-w-2xl mx-auto text-center">
      <!-- Cabeçalho -->
      <div class="reveal mb-12">
        <p class="section-label mb-4">Agendamento</p>
        <div class="divider-elegant mb-6"></div>
        <h2
          id="booking-heading"
          class="font-serif mb-4"
          style="color: var(--color-charcoal-800);"
        >
          {title}
        </h2>
        <p style="color: var(--color-charcoal-400);">{subtitle}</p>
      </div>

      <!-- Opções de agendamento -->
      <div class="grid gap-4 sm:grid-cols-2 mb-8 reveal">
        <!-- WhatsApp -->
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="card-premium p-6 flex flex-col items-center gap-4 group text-center no-underline hover:border-[--color-gold-200] border border-transparent"
          aria-label="Agendar pelo WhatsApp"
        >
          <div
            class="w-14 h-14 rounded-2xl flex items-center justify-center text-white transition-transform duration-300 group-hover:scale-110"
            style="background: linear-gradient(135deg, #25d366, #128c7e);"
            aria-hidden="true"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <p class="font-medium mb-1" style="color: var(--color-charcoal-700);">Via WhatsApp</p>
            <p class="text-sm" style="color: var(--color-charcoal-400);">Resposta rápida</p>
          </div>
        </a>

        <!-- Calendly / Agenda Online -->
        <a
          href={calendlyUrl || "#"}
          target={calendlyUrl ? "_blank" : "_self"}
          rel="noopener noreferrer"
          class="card-premium p-6 flex flex-col items-center gap-4 group text-center no-underline hover:border-[--color-gold-200] border border-transparent"
          aria-label="Agendar pela agenda online"
        >
          <div
            class="w-14 h-14 rounded-2xl flex items-center justify-center text-white transition-transform duration-300 group-hover:scale-110"
            style="background: linear-gradient(135deg, var(--color-gold-500), var(--color-rose-500));"
            aria-hidden="true"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <div>
            <p class="font-medium mb-1" style="color: var(--color-charcoal-700);">Google Agenda</p>
            <p class="text-sm" style="color: var(--color-charcoal-400);">Escolha o melhor horário</p>
          </div>
        </a>
      </div>

      <!-- Horários de funcionamento -->
      <div
        class="card-premium p-6 reveal"
        aria-label="Horários de funcionamento"
      >
        <p class="text-sm font-semibold mb-4 tracking-wide" style="color: var(--color-charcoal-600);">
          Horários de atendimento
        </p>
        <div class="space-y-2">
          {SITE.hours.map(({ day, time }) => (
            <div class="flex justify-between items-center text-sm py-1.5 border-b last:border-0" style="border-color: var(--color-cream-300);">
              <span style="color: var(--color-charcoal-600);">{day}</span>
              <span class="font-medium" style="color: var(--color-charcoal-700);">{time}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Nota de segurança -->
      <p class="text-xs mt-6 text-center" style="color: var(--color-charcoal-300);">
        🔒 Seus dados estão seguros. Não compartilhamos informações com terceiros.
      </p>
    </div>
  </div>
</section>
