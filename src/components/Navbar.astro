---
import { SITE, NAV_LINKS } from "@data/site";
const { pathname } = Astro.url;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  role="banner"
>
  <!-- Barra superior premium -->
  <div
    id="navbar-inner"
    class="transition-all duration-300"
    style="background: transparent;"
  >
    <div class="container-site">
      <nav
        class="flex items-center justify-between py-5"
        aria-label="Navegação principal"
      >
        <!-- Logo -->
        <a
          href="/"
          class="flex flex-col leading-none group"
          aria-label={`${SITE.name} — Ir para o início`}
        >
          <span
            class="font-serif text-2xl font-medium tracking-wide transition-colors duration-200"
            id="logo-name"
            style="color: var(--color-charcoal-800);"
          >
            {SITE.shortName}
          </span>
          <span
            class="text-xs tracking-[0.25em] uppercase font-light transition-colors duration-200"
            id="logo-tagline"
            style="color: var(--color-gold-500);"
          >
            estética
          </span>
        </a>

        <!-- Links de navegação — desktop -->
        <ul class="hidden md:flex items-center gap-8" role="list">
          {
            NAV_LINKS.map(({ label, href }) => {
              const isActive = pathname === href || (href !== "/" && pathname.startsWith(href));
              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      "nav-link relative text-sm font-medium tracking-wide transition-colors duration-200 py-1",
                      "after:absolute after:bottom-0 after:left-0 after:h-px after:bg-current",
                      "after:transition-all after:duration-300",
                      isActive
                        ? "after:w-full"
                        : "after:w-0 hover:after:w-full",
                    ]}
                    aria-current={isActive ? "page" : undefined}
                    style="color: var(--color-charcoal-600);"
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }
        </ul>

        <!-- CTA desktop -->
        <div class="hidden md:flex items-center gap-4">
          <a
            href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-sm py-3 px-6"
            aria-label="Agendar via WhatsApp"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Agendar
          </a>
        </div>

        <!-- Hamburger — mobile -->
        <button
          id="menu-toggle"
          class="md:hidden p-2 rounded-lg transition-colors"
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="block w-6 h-0.5 transition-all duration-300 hamburger-line" style="background:var(--color-charcoal-700);"></span>
          <span class="block w-6 h-0.5 mt-1.5 transition-all duration-300 hamburger-line" style="background:var(--color-charcoal-700);"></span>
          <span class="block w-6 h-0.5 mt-1.5 transition-all duration-300 hamburger-line" style="background:var(--color-charcoal-700);"></span>
        </button>
      </nav>
    </div>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden transition-all duration-300"
    style="max-height: 0; background: white;"
    role="navigation"
    aria-label="Menu mobile"
    aria-hidden="true"
  >
    <div class="container-site py-6 flex flex-col gap-4">
      {
        NAV_LINKS.map(({ label, href }) => {
          const isActive = pathname === href || (href !== "/" && pathname.startsWith(href));
          return (
            <a
              href={href}
              class:list={[
                "text-base font-medium py-2 border-b transition-colors",
                isActive
                  ? "text-[--color-gold-600] border-[--color-gold-200]"
                  : "text-[--color-charcoal-700] border-[--color-cream-300] hover:text-[--color-gold-500]",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {label}
            </a>
          );
        })
      }
      <a
        href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-center mt-2"
      >
        Agendar pelo WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  // ── Comportamento da Navbar ────────────────────────────────────────────────
  const navbar = document.getElementById("navbar");
  const navbarInner = document.getElementById("navbar-inner");
  const logoName = document.getElementById("logo-name");
  const logoTagline = document.getElementById("logo-tagline");
  const navLinks = document.querySelectorAll<HTMLElement>(".nav-link");
  const hamburgerLines = document.querySelectorAll<HTMLElement>(".hamburger-line");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  // Scroll: tornar navbar sólida após 80px
  const updateNavbar = () => {
    const scrolled = window.scrollY > 80;
    if (scrolled) {
      navbarInner?.style.setProperty("background", "rgba(255, 252, 249, 0.97)");
      navbarInner?.style.setProperty("backdrop-filter", "blur(12px)");
      navbarInner?.style.setProperty("border-bottom", "1px solid rgba(220, 201, 181, 0.4)");
      navbarInner?.style.setProperty("box-shadow", "0 2px 20px rgba(180, 120, 100, 0.08)");
      if (logoName) { logoName.style.color = "var(--color-charcoal-800)"; }
      if (logoTagline) { logoTagline.style.color = "var(--color-gold-500)"; }
      navLinks.forEach((l) => { l.style.color = "var(--color-charcoal-600)"; });
      hamburgerLines.forEach((l) => { l.style.background = "var(--color-charcoal-700)"; });
    } else {
      navbarInner?.style.setProperty("background", "transparent");
      navbarInner?.style.setProperty("backdrop-filter", "none");
      navbarInner?.style.setProperty("border-bottom", "none");
      navbarInner?.style.setProperty("box-shadow", "none");
      if (logoName) { logoName.style.color = "var(--color-charcoal-800)"; }
      if (logoTagline) { logoTagline.style.color = "var(--color-gold-500)"; }
      navLinks.forEach((l) => { l.style.color = "var(--color-charcoal-600)"; });
      hamburgerLines.forEach((l) => { l.style.background = "var(--color-charcoal-700)"; });
    }
  };

  window.addEventListener("scroll", updateNavbar, { passive: true });
  updateNavbar();

  // Mobile menu toggle
  let isOpen = false;
  menuToggle?.addEventListener("click", () => {
    isOpen = !isOpen;
    menuToggle.setAttribute("aria-expanded", String(isOpen));
    if (mobileMenu) {
      mobileMenu.style.maxHeight = isOpen ? `${mobileMenu.scrollHeight}px` : "0";
      mobileMenu.setAttribute("aria-hidden", String(!isOpen));
    }
  });

  // Fechar menu ao clicar em um link
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      isOpen = false;
      menuToggle?.setAttribute("aria-expanded", "false");
      if (mobileMenu) {
        mobileMenu.style.maxHeight = "0";
        mobileMenu.setAttribute("aria-hidden", "true");
      }
    });
  });
</script>
