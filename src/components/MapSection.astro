---
import { SITE } from "@data/site";
---

<section
  class="section-padding"
  style="background: var(--color-cream-100);"
  aria-labelledby="map-heading"
>
  <div class="container-site">
    <!-- Cabeçalho centralizado -->
    <div class="text-center mb-12 reveal">
      <p class="section-label mb-4">Localização</p>
      <div class="divider-elegant mb-6"></div>
      <h2
        id="map-heading"
        class="font-serif"
        style="color: var(--color-charcoal-800);"
      >
        Venha nos <em style="color: var(--color-gold-600);">visitar</em>
      </h2>
    </div>

    <div class="grid gap-12 lg:grid-cols-2 items-center">
      <!-- Informações de localização -->
      <div class="reveal">
        <!-- Endereço -->
        <div class="space-y-5">
          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
              style="background: var(--color-nude-100);"
              aria-hidden="true"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-gold-600);">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-sm mb-0.5" style="color: var(--color-charcoal-700);">Endereço</p>
              <address class="text-sm not-italic leading-relaxed" style="color: var(--color-charcoal-500);">
                {SITE.address.street}<br />
                {SITE.address.neighborhood}<br />
                {SITE.address.city} — {SITE.address.state}<br />
                CEP {SITE.address.zipCode}
              </address>
            </div>
          </div>

          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
              style="background: var(--color-nude-100);"
              aria-hidden="true"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-gold-600);">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.82 19.79 19.79 0 01.08 1.18 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.18 6.18l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.9v2.02z"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-sm mb-0.5" style="color: var(--color-charcoal-700);">WhatsApp</p>
              <a
                href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm transition-colors hover:text-[--color-gold-600]"
                style="color: var(--color-charcoal-500);"
                aria-label={`Enviar mensagem para ${SITE.whatsapp}`}
              >
                {SITE.schema.telephone}
              </a>
            </div>
          </div>

          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
              style="background: var(--color-nude-100);"
              aria-hidden="true"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-gold-600);">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-sm mb-1" style="color: var(--color-charcoal-700);">Horários</p>
              <div class="space-y-1">
                {SITE.hours.map(({ day, time }) => (
                  <div class="flex gap-2 text-sm" style="color: var(--color-charcoal-500);">
                    <span>{day}:</span>
                    <span class="font-medium" style="color: var(--color-charcoal-700);">{time}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Botão Google Maps -->
          <a
            href={SITE.address.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary mt-2 w-fit"
            aria-label="Abrir localização no Google Maps"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            Ver no Google Maps
          </a>
        </div>
      </div>

      <!-- Mapa embed -->
      <div class="reveal">
        <div
          class="rounded-3xl overflow-hidden"
          style="height: 420px; box-shadow: var(--shadow-medium);"
          role="region"
          aria-label="Mapa da localização"
        >
          {SITE.address.googleMapsEmbed ? (
            <iframe
              src={SITE.address.googleMapsEmbed}
              width="100%"
              height="100%"
              style="border: 0; display: block;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Mapa: ${SITE.name}`}
            />
          ) : (
            <!-- Placeholder elegante quando sem embed configurado -->
            <div
              class="w-full h-full img-placeholder flex-col gap-4"
              style="background: linear-gradient(135deg, var(--color-cream-200), var(--color-nude-200));"
            >
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-gold-400);" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <p class="text-sm font-medium" style="color: var(--color-charcoal-400);">
                Configure o embed do Google Maps<br />
                no arquivo <code style="color: var(--color-gold-600);">src/data/site.ts</code>
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
