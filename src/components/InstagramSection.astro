---
import { SITE } from "@data/site";

// Placeholders de posts do Instagram (substituir por API real ou plugin)
const placeholderPosts = Array.from({ length: 6 }, (_, i) => ({
  id: i + 1,
  alt: `Post ${i + 1} — ${SITE.instagramHandle}`,
  emoji: ["👁️", "✨", "🌸", "💄", "🌟", "💎"][i],
}));
---

<section
  class="section-padding"
  style="background: var(--color-cream-100);"
  aria-labelledby="instagram-heading"
>
  <div class="container-site">
    <!-- Cabeçalho -->
    <div class="text-center mb-12 reveal">
      <div class="flex items-center justify-center gap-3 mb-4">
        <!-- Ícone Instagram -->
        <div
          class="w-10 h-10 rounded-xl flex items-center justify-center text-white"
          style="background: linear-gradient(135deg, #f58529, #dd2a7b, #8134af);"
          aria-hidden="true"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
        <p class="section-label">{SITE.instagramHandle}</p>
      </div>
      <div class="divider-elegant mb-6"></div>
      <h2
        id="instagram-heading"
        class="font-serif"
        style="color: var(--color-charcoal-800);"
      >
        Siga no Instagram
      </h2>
      <p class="mt-3 max-w-md mx-auto text-sm" style="color: var(--color-charcoal-400);">
        Acompanhe os resultados, dicas e novidades diárias
      </p>
    </div>

    <!-- Grid de posts -->
    <div
      class="grid grid-cols-3 gap-2 md:gap-3 mb-8"
      aria-label="Posts do Instagram"
      role="list"
    >
      {
        placeholderPosts.map((post, index) => (
          <a
            href={SITE.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden rounded-xl aspect-square img-placeholder reveal cursor-pointer"
            style={`
              background: linear-gradient(
                ${135 + index * 30}deg,
                var(--color-nude-${100 + (index % 3) * 100}) 0%,
                var(--color-gold-${100 + (index % 2) * 100}) 100%
              );
              animation-delay: ${index * 60}ms;
            `}
            aria-label={`Ver post: ${post.alt}`}
            role="listitem"
          >
            <span class="text-3xl opacity-30 group-hover:opacity-10 transition-opacity duration-300" aria-hidden="true">
              {post.emoji}
            </span>

            <!-- Overlay no hover -->
            <div
              class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300"
              style="background: rgba(20,10,5,0.5);"
              aria-hidden="true"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </div>
          </a>
        ))
      }
    </div>

    <!-- CTA Instagram -->
    <div class="text-center reveal">
      <a
        href={SITE.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-full font-medium text-white transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5"
        style="background: linear-gradient(135deg, #f58529, #dd2a7b, #8134af);"
        aria-label={`Seguir ${SITE.instagramHandle} no Instagram`}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        Seguir {SITE.instagramHandle}
      </a>
    </div>
  </div>
</section>
