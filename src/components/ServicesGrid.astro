---
import { SERVICES, SITE } from "@data/site";

interface Props {
  title?: string;
  subtitle?: string;
  showAll?: boolean;
  featuredOnly?: boolean;
}

const {
  title = "Especialidades",
  subtitle = "Procedimentos médico-estéticos de alta performance com protocolos personalizados para cada paciente.",
  showAll = false,
  featuredOnly = false,
} = Astro.props;

const services = featuredOnly
  ? SERVICES.filter((s) => s.featured)
  : showAll
  ? SERVICES
  : SERVICES.slice(0, 6);

const whatsappBase = `https://wa.me/${SITE.whatsapp}?text=`;

// SVG icons por serviço (linha fina, minimalista)
const serviceIcons: Record<string, string> = {
  "harmonizacao-full-face": `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`,
  "otomoldacao": `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M7 8c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.5-.66 2.85-1.71 3.78"/></svg>`,
  "nt-lifting": `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><path d="M12 2v20M2 12h20"/><path d="M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07"/></svg>`,
  "botox": `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M8 12h8M12 8v8"/></svg>`,
  "bioestimuladores": `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
  "perfiloplastia": `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  "harmonizacao-masculina": `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>`,
};
---

<section class="section-padding" style="background: var(--color-dark-900);" aria-labelledby="services-heading">
  <div class="container-site">
    <!-- Cabeçalho -->
    <div class="text-center mb-16 reveal">
      <p class="section-label mb-5" style="color: var(--color-gold-600);">{title}</p>
      <div class="divider-elegant mb-8" style="margin-inline: auto;"></div>
      <h2
        id="services-heading"
        style="color: var(--color-cream-100); font-family: var(--font-display); margin-bottom: 1.5rem;"
      >
        Procedimentos que<br />
        <em style="color: var(--color-gold-600); font-style: italic;">transformam vidas</em>
      </h2>
      <p class="max-w-xl mx-auto" style="color: var(--color-cream-400); font-family: var(--font-body); font-size: 0.95rem;">
        {subtitle}
      </p>
    </div>

    <!-- Grid de serviços — dark cards -->
    <div
      class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
      role="list"
      aria-label="Lista de procedimentos"
    >
      {
        services.map((service, index) => {
          const whatsappMsg = encodeURIComponent(
            `Olá, Dra. Nayara! Gostaria de agendar uma avaliação para ${service.name}.`
          );
          const svgIcon = serviceIcons[service.id] || serviceIcons["botox"];
          const hasHighlight = (service as any).highlight;

          return (
            <article
              class="group reveal flex flex-col p-8"
              style={`background: var(--color-dark-700); border-top: 2px solid var(--color-gold-500); border-left: 1px solid rgba(201,169,110,0.1); border-right: 1px solid rgba(201,169,110,0.1); border-bottom: 1px solid rgba(201,169,110,0.1); box-shadow: var(--shadow-soft); transition: box-shadow 0.25s, transform 0.25s; animation-delay: ${index * 80}ms;`}
              role="listitem"
              aria-labelledby={`service-${service.id}`}
              onmouseenter="this.style.boxShadow='var(--shadow-medium)';this.style.transform='translateY(-3px)'"
              onmouseleave="this.style.boxShadow='var(--shadow-soft)';this.style.transform='translateY(0)'"
            >
              <!-- Header: ícone + badge de destaque -->
              <div class="flex items-start justify-between mb-7">
                <div
                  class="w-11 h-11 flex items-center justify-center"
                  style="color: var(--color-gold-400); background: rgba(201,169,110,0.1); border: 1px solid rgba(201,169,110,0.25);"
                  aria-hidden="true"
                  set:html={svgIcon}
                />
                {hasHighlight && (
                  <span
                    style="font-family: var(--font-body); font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-gold-400); border: 1px solid rgba(201,169,110,0.3); padding: 0.25rem 0.6rem; background: rgba(201,169,110,0.08);"
                  >
                    {(service as any).highlight}
                  </span>
                )}
              </div>

              <!-- Nome -->
              <h3
                id={`service-${service.id}`}
                style="color: var(--color-cream-100); font-family: var(--font-display); font-weight: 600; font-size: 1.4rem; margin-bottom: 0.75rem; line-height: 1.2;"
              >
                {service.name}
              </h3>

              <!-- Descrição curta -->
              <p
                style="color: var(--color-cream-400); font-family: var(--font-body); font-size: 0.875rem; line-height: 1.7; margin-bottom: 1.25rem;"
              >
                {service.shortDescription}
              </p>

              <!-- Divisor dourado -->
              <div
                class="mb-5 transition-all duration-300 group-hover:w-12"
                style="width: 24px; height: 1px; background: var(--color-gold-400);"
                aria-hidden="true"
              ></div>

              <!-- Benefícios -->
              <ul class="space-y-2.5 mb-7 flex-1" aria-label={`Benefícios de ${service.name}`}>
                {service.benefits.slice(0, 3).map((benefit) => (
                  <li class="flex items-start gap-3" style="color: var(--color-cream-400); font-family: var(--font-body); font-size: 0.82rem;">
                    <svg
                      class="mt-0.5 shrink-0"
                      width="12" height="12"
                      viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="1.5"
                      style="color: var(--color-gold-500);"
                      aria-hidden="true"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {benefit}
                  </li>
                ))}
              </ul>

              <!-- Duração + CTA -->
              <div
                class="flex items-center justify-between mt-auto pt-5"
                style="border-top: 1px solid rgba(201,169,110,0.15);"
              >
                <span style="font-family: var(--font-body); font-size: 0.7rem; color: var(--color-cream-500); letter-spacing: 0.08em; text-transform: uppercase;">
                  {service.duration}
                </span>
                <a
                  href={`${whatsappBase}${whatsappMsg}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 group/link transition-colors duration-200"
                  style="color: var(--color-gold-600); font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;"
                  aria-label={`${service.ctaText} — ${service.name}`}
                >
                  {service.ctaText}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                    class="transition-transform duration-200 group-hover/link:translate-x-1" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Link para todos os serviços -->
    {!showAll && (
      <div class="text-center mt-12 reveal">
        <a
          href="/servicos"
          style="display: inline-flex; align-items: center; gap: 0.75rem; font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-gold-600); border-bottom: 1px solid var(--color-gold-400); padding-bottom: 0.25rem; transition: all 0.2s;"
        >
          Ver todos os procedimentos
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>
