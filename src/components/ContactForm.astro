---
import { SITE } from "@data/site";

interface Props {
  title?: string;
}

const { title = "Envie uma mensagem" } = Astro.props;
const formEndpoint = SITE.formEndpoint;
---

<div class="reveal">
  <h3 class="font-serif text-2xl mb-6" style="color: var(--color-charcoal-800);">
    {title}
  </h3>

  <form
    id="contact-form"
    action={formEndpoint || "#"}
    method="POST"
    novalidate
    aria-label="Formulário de contato"
    class="space-y-5"
  >
    <!-- Campo oculto anti-spam -->
    <input type="text" name="_gotcha" style="display: none;" tabindex="-1" aria-hidden="true" />
    <input type="hidden" name="_subject" value="Nova mensagem via site — Dra. Nayara Tofoli" />
    <input type="hidden" name="_language" value="pt" />

    <!-- Nome -->
    <div class="form-group">
      <label
        for="name"
        class="block text-sm font-medium mb-2"
        style="color: var(--color-charcoal-600);"
      >
        Nome completo <span class="text-red-400" aria-label="obrigatório">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        placeholder="Seu nome"
        class="w-full px-4 py-3 rounded-xl border outline-none transition-all duration-200 text-sm"
        style="
          border-color: var(--color-cream-300);
          background: var(--color-cream-50);
          color: var(--color-charcoal-700);
        "
        aria-required="true"
        aria-describedby="name-error"
      />
      <p id="name-error" class="field-error text-xs mt-1.5 hidden" style="color: #e05b73;" role="alert">
        Por favor, insira seu nome.
      </p>
    </div>

    <!-- Email -->
    <div class="form-group">
      <label
        for="email"
        class="block text-sm font-medium mb-2"
        style="color: var(--color-charcoal-600);"
      >
        E-mail <span class="text-red-400" aria-label="obrigatório">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="seu@email.com"
        class="w-full px-4 py-3 rounded-xl border outline-none transition-all duration-200 text-sm"
        style="
          border-color: var(--color-cream-300);
          background: var(--color-cream-50);
          color: var(--color-charcoal-700);
        "
        aria-required="true"
        aria-describedby="email-error"
      />
      <p id="email-error" class="field-error text-xs mt-1.5 hidden" style="color: #e05b73;" role="alert">
        Por favor, insira um e-mail válido.
      </p>
    </div>

    <!-- Telefone -->
    <div class="form-group">
      <label
        for="phone"
        class="block text-sm font-medium mb-2"
        style="color: var(--color-charcoal-600);"
      >
        WhatsApp / Telefone
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        autocomplete="tel"
        placeholder="(11) 9 0000-0000"
        class="w-full px-4 py-3 rounded-xl border outline-none transition-all duration-200 text-sm"
        style="
          border-color: var(--color-cream-300);
          background: var(--color-cream-50);
          color: var(--color-charcoal-700);
        "
      />
    </div>

    <!-- Serviço de interesse -->
    <div class="form-group">
      <label
        for="service"
        class="block text-sm font-medium mb-2"
        style="color: var(--color-charcoal-600);"
      >
        Serviço de interesse
      </label>
      <select
        id="service"
        name="service"
        class="w-full px-4 py-3 rounded-xl border outline-none transition-all duration-200 text-sm appearance-none cursor-pointer"
        style="
          border-color: var(--color-cream-300);
          background: var(--color-cream-50);
          color: var(--color-charcoal-700);
        "
        aria-label="Selecione o serviço de interesse"
      >
        <option value="">Selecione um serviço</option>
        <option value="extensao-cilios">Extensão de Cílios</option>
        <option value="design-sobrancelhas">Design de Sobrancelhas</option>
        <option value="botox">Botox Facial</option>
        <option value="harmonizacao">Harmonização Facial</option>
        <option value="estetica-facial">Estética Facial</option>
        <option value="outros">Outros / Dúvidas</option>
      </select>
    </div>

    <!-- Mensagem -->
    <div class="form-group">
      <label
        for="message"
        class="block text-sm font-medium mb-2"
        style="color: var(--color-charcoal-600);"
      >
        Mensagem <span class="text-red-400" aria-label="obrigatório">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        required
        rows="4"
        placeholder="Como posso te ajudar?"
        class="w-full px-4 py-3 rounded-xl border outline-none transition-all duration-200 text-sm resize-none"
        style="
          border-color: var(--color-cream-300);
          background: var(--color-cream-50);
          color: var(--color-charcoal-700);
        "
        aria-required="true"
        aria-describedby="message-error"
      ></textarea>
      <p id="message-error" class="field-error text-xs mt-1.5 hidden" style="color: #e05b73;" role="alert">
        Por favor, escreva sua mensagem.
      </p>
    </div>

    <!-- Consentimento LGPD -->
    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="consent"
        name="consent"
        required
        class="mt-0.5 cursor-pointer"
        aria-required="true"
        aria-describedby="consent-error"
      />
      <label for="consent" class="text-xs leading-relaxed cursor-pointer" style="color: var(--color-charcoal-400);">
        Concordo com o uso dos meus dados para resposta ao contato, conforme a
        <a href="#" class="underline hover:text-[--color-gold-600] transition-colors">Política de Privacidade</a>.
      </label>
    </div>
    <p id="consent-error" class="field-error text-xs hidden" style="color: #e05b73;" role="alert">
      É necessário aceitar os termos para continuar.
    </p>

    <!-- Botão enviar -->
    <button
      type="submit"
      id="submit-btn"
      class="btn-primary w-full justify-center text-base"
      aria-label="Enviar mensagem"
    >
      <span id="submit-text">Enviar mensagem</span>
      <svg id="submit-spinner" class="hidden animate-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="60" stroke-dashoffset="20" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Mensagem de sucesso -->
    <div
      id="form-success"
      class="hidden p-4 rounded-xl text-sm text-center"
      style="background: var(--color-nude-100); color: var(--color-gold-700); border: 1px solid var(--color-gold-200);"
      role="status"
      aria-live="polite"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="display:inline;vertical-align:middle;margin-right:6px;" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Mensagem enviada! Em breve entro em contato.
    </div>
  </form>
</div>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const submitText = document.getElementById("submit-text")!;
  const submitSpinner = document.getElementById("submit-spinner")!;
  const successMsg = document.getElementById("form-success")!;

  // Estilo de foco nos inputs
  const inputs = form.querySelectorAll("input, textarea, select");
  inputs.forEach((input) => {
    input.addEventListener("focus", () => {
      (input as HTMLElement).style.borderColor = "var(--color-gold-400)";
      (input as HTMLElement).style.boxShadow = "0 0 0 3px rgba(212,115,106,0.12)";
    });
    input.addEventListener("blur", () => {
      (input as HTMLElement).style.borderColor = "var(--color-cream-300)";
      (input as HTMLElement).style.boxShadow = "none";
    });
  });

  // Validação em tempo real
  const validateField = (input: HTMLInputElement | HTMLTextAreaElement) => {
    const errorEl = document.getElementById(`${input.id}-error`);
    if (!errorEl) return input.checkValidity();
    const valid = input.checkValidity();
    errorEl.classList.toggle("hidden", valid);
    (input as HTMLElement).style.borderColor = valid ? "var(--color-cream-300)" : "#e05b73";
    return valid;
  };

  inputs.forEach((input) => {
    input.addEventListener("blur", () => validateField(input as HTMLInputElement));
  });

  // Envio do formulário
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Validação
    let isValid = true;
    ["name", "email", "message"].forEach((id) => {
      const input = document.getElementById(id) as HTMLInputElement;
      if (!validateField(input)) isValid = false;
    });

    const consent = document.getElementById("consent") as HTMLInputElement;
    const consentError = document.getElementById("consent-error")!;
    if (!consent.checked) {
      consentError.classList.remove("hidden");
      isValid = false;
    } else {
      consentError.classList.add("hidden");
    }

    if (!isValid) return;

    // Loading state
    submitBtn.disabled = true;
    submitText.textContent = "Enviando...";
    submitSpinner.classList.remove("hidden");

    const formData = new FormData(form);
    const action = form.action;

    // Se endpoint configurado, enviar; caso contrário, simular sucesso
    if (action && !action.endsWith("#")) {
      try {
        const res = await fetch(action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (res.ok) {
          form.reset();
          successMsg.classList.remove("hidden");
        } else {
          throw new Error("Erro no servidor");
        }
      } catch {
        alert("Erro ao enviar. Por favor, entre em contato pelo WhatsApp.");
      }
    } else {
      // Demo: simula sucesso
      await new Promise((r) => setTimeout(r, 1200));
      form.reset();
      successMsg.classList.remove("hidden");
    }

    submitBtn.disabled = false;
    submitText.textContent = "Enviar mensagem";
    submitSpinner.classList.add("hidden");
    successMsg.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
</script>
