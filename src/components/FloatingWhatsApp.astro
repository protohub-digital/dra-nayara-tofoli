---
import { SITE } from "@data/site";

const whatsappUrl = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`;
---

<!-- Botão flutuante WhatsApp -->
<div
  class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3"
  id="whatsapp-float-wrapper"
>
  <!-- Balão de tooltip -->
  <div
    id="whatsapp-tooltip"
    class="hidden sm:flex items-center gap-3 bg-white rounded-2xl px-4 py-3 transition-all duration-300 opacity-0 translate-x-4"
    style="box-shadow: var(--shadow-medium); pointer-events: none;"
    role="tooltip"
    id="whatsapp-tooltip"
  >
    <!-- Avatar placeholder -->
    <div
      class="w-10 h-10 rounded-full flex items-center justify-center text-white text-sm font-medium shrink-0"
      style="background: linear-gradient(135deg, var(--color-gold-500), var(--color-rose-500));"
      aria-hidden="true"
    >
      N
    </div>
    <div>
      <p class="text-xs font-semibold" style="color: var(--color-charcoal-700);">Dra. Nayara Tofoli</p>
      <p class="text-xs" style="color: var(--color-charcoal-400);">Respondo em minutos</p>
    </div>
    <!-- Seta do balão -->
    <div
      class="absolute -right-2 top-1/2 -translate-y-1/2 w-3 h-3 bg-white rotate-45"
      style="box-shadow: 2px -2px 4px rgba(0,0,0,0.06);"
      aria-hidden="true"
    ></div>
  </div>

  <!-- Botão principal -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    id="whatsapp-btn"
    class="group relative flex items-center justify-center w-14 h-14 rounded-full text-white transition-all duration-300 hover:scale-110 hover:shadow-2xl"
    style="background: linear-gradient(135deg, #25d366, #128c7e); box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);"
    aria-label="Falar com a Dra. Nayara pelo WhatsApp"
    title="Falar pelo WhatsApp"
  >
    <!-- Ícone WhatsApp -->
    <svg
      width="26"
      height="26"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      class="transition-transform duration-300 group-hover:scale-110"
    >
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>

    <!-- Pulse ring animado -->
    <span
      class="absolute inset-0 rounded-full animate-ping opacity-25"
      style="background: #25d366;"
      aria-hidden="true"
    ></span>
  </a>
</div>

<script>
  // Mostrar tooltip após 2s, esconder ao clicar
  const tooltip = document.getElementById("whatsapp-tooltip");
  const btn = document.getElementById("whatsapp-btn");

  if (tooltip && btn) {
    setTimeout(() => {
      tooltip.style.opacity = "1";
      tooltip.style.transform = "translateX(0)";
      tooltip.style.pointerEvents = "auto";
      tooltip.classList.remove("opacity-0", "translate-x-4");
    }, 2000);

    // Esconder tooltip ao clicar no botão
    btn.addEventListener("click", () => {
      tooltip.style.opacity = "0";
      tooltip.style.pointerEvents = "none";
    });

    // Esconder tooltip após 8s automaticamente
    setTimeout(() => {
      tooltip.style.opacity = "0";
      tooltip.style.pointerEvents = "none";
    }, 10000);
  }
</script>
