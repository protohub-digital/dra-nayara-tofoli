---
import { SITE, ABOUT } from "@data/site";

interface Props {
  headline?: string;
  headlineBold?: string;
  subheadline?: string;
  ctaText?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  imageSrc?: string;
  imageAlt?: string;
  badge?: string;
}

const {
  headline = "Sua beleza,",
  headlineBold = "com precisão clínica.",
  subheadline = "Harmonização facial e otomoldação em Colatina, ES — resultados naturais que atravessam fronteiras.",
  ctaText = "Agendar Avaliação",
  secondaryCtaText = "Conhecer Serviços",
  secondaryCtaHref = "/servicos",
  imageSrc = "/images/profile/profile.jpg",
  imageAlt = "Dra. Nayara Tofoli — Harmonização Facial em Colatina, ES",
  badge = "CRO-ES 7253 · Harmonização Facial e Orelhas · Colatina, ES",
} = Astro.props;

const whatsappUrl = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`;
---

<section
  class="relative flex overflow-hidden w-full"
  style="background-color: var(--color-cream-100); min-height: 100vh; min-height: 100svh;"
  aria-label="Dra. Nayara Tofoli — Harmonização Facial e Orelhas"
>
  <!-- LADO ESQUERDO: conteúdo (55% desktop) -->
  <div class="relative z-10 flex flex-col w-full lg:w-[55%] px-6 md:px-12 xl:px-20 pt-28 pb-10 lg:pt-32 lg:pb-12">

    <!-- Bloco superior: badge + headline + subheadline + CTAs -->
    <div class="flex-1 flex flex-col justify-center">

      <!-- Badge clínico -->
      {badge && (
        <div class="mb-8 animate-fade-in">
          <span class="badge-clinic">
            <span style="width:5px;height:5px;background:var(--color-gold-500);border-radius:50%;display:inline-block;flex-shrink:0;" aria-hidden="true"></span>
            {badge}
          </span>
        </div>
      )}

      <!-- Headline -->
      <h1 class="animate-fade-in-up delay-100" style="margin-bottom: 1.25rem;">
        <span
          class="block"
          style="color: var(--color-charcoal-300); font-weight: 300; font-size: clamp(2.5rem, 4.5vw, 5rem); line-height: 1.05; font-family: var(--font-display); font-style: italic;"
        >
          {headline}
        </span>
        <span
          class="block"
          style="color: var(--color-charcoal-800); font-weight: 700; font-size: clamp(2.5rem, 4.5vw, 5rem); line-height: 1.05; font-family: var(--font-display);"
        >
          {headlineBold}
        </span>
      </h1>

      <!-- Linha dourada -->
      <div
        class="mb-6 animate-fade-in-up delay-200"
        style="width: 36px; height: 1px; background: var(--color-gold-500);"
        aria-hidden="true"
      ></div>

      <!-- Subheadline -->
      <p
        class="animate-fade-in-up delay-200"
        style="color: var(--color-charcoal-400); font-family: var(--font-body); font-size: clamp(0.9rem, 1.3vw, 1rem); line-height: 1.8; margin-bottom: 2.25rem; font-weight: 300; max-width: 400px;"
      >
        {subheadline}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3 animate-fade-in-up delay-300">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          aria-label="Agendar avaliação via WhatsApp"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {ctaText}
        </a>

        <a href={secondaryCtaHref} class="btn-hero-secondary">
          {secondaryCtaText}
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bloco inferior: stats fixados no rodapé do hero -->
    <div
      class="animate-fade-in-up delay-400"
      style="border-top: 1px solid var(--color-cream-300); padding-top: 1.5rem; margin-top: 2rem;"
      aria-label="Estatísticas"
    >
      <div class="grid grid-cols-3 gap-2 md:gap-4">
        {[
          { value: ABOUT.experience, label: "Anos de experiência" },
          { value: ABOUT.clients, label: "Pacientes atendidos" },
          { value: "4,9⭐", label: "avaliação Google" },
        ].map(({ value, label }) => (
          <div class="flex flex-col gap-0.5">
            <span
              style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 300; color: var(--color-gold-600); line-height: 1;"
            >
              {value}
            </span>
            <span style="font-family: var(--font-body); font-size: 0.6rem; color: var(--color-charcoal-400); letter-spacing: 0.12em; text-transform: uppercase;">
              {label}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- LADO DIREITO: elemento premium editorial -->
  <div
    class="hidden lg:flex absolute right-0 bottom-0 w-[45%] items-center justify-center"
    style="overflow: hidden; top: 64px; background: linear-gradient(135deg, var(--color-cream-200) 0%, var(--color-gold-50) 55%, var(--color-cream-100) 100%);"
    aria-hidden="true"
  >
    <!-- Fade esquerdo para fundir com o fundo cream -->
    <div
      class="absolute inset-0 z-10"
      style="background: linear-gradient(to right, var(--color-cream-100) 0%, transparent 22%);"
    ></div>

    <!-- SVG hairline pattern diagonal -->
    <svg
      class="absolute inset-0 w-full h-full"
      xmlns="http://www.w3.org/2000/svg"
      style="opacity: 0.18;"
    >
      <defs>
        <pattern id="hairline" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="32" stroke="var(--color-gold-400)" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hairline)" />
    </svg>

    <!-- Linha dourada vertical à esquerda -->
    <div
      class="absolute left-0 top-[10%] bottom-[10%] z-20"
      style="width: 1px; background: linear-gradient(to bottom, transparent, var(--color-gold-400) 30%, var(--color-gold-400) 70%, transparent);"
    ></div>

    <!-- Conteúdo central -->
    <div class="relative z-20 flex flex-col items-center justify-center text-center px-16 gap-6">

      <!-- Monograma NT — marca d'água -->
      <span
        class="absolute select-none pointer-events-none"
        style="font-family: var(--font-display); font-size: 18rem; font-weight: 300; color: var(--color-gold-600); opacity: 0.05; line-height: 1; top: 50%; left: 50%; transform: translate(-50%, -50%);"
      >NT</span>

      <!-- Ornamento superior -->
      <div style="display: flex; align-items: center; gap: 12px;">
        <div style="width: 32px; height: 1px; background: var(--color-gold-400);"></div>
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" style="flex-shrink:0;">
          <rect x="4" y="0" width="2" height="10" fill="var(--color-gold-400)" opacity="0.6"/>
          <rect x="0" y="4" width="10" height="2" fill="var(--color-gold-400)" opacity="0.6"/>
        </svg>
        <div style="width: 32px; height: 1px; background: var(--color-gold-400);"></div>
      </div>

      <!-- Citação -->
      <blockquote style="margin: 0;">
        <p style="font-family: var(--font-display); font-size: clamp(1.6rem, 2.2vw, 2.4rem); font-style: italic; font-weight: 300; color: var(--color-charcoal-700); line-height: 1.3; letter-spacing: 0.01em;">
          "Entrego sua<br/>melhor versão"
        </p>
      </blockquote>

      <!-- Ornamento inferior -->
      <div style="display: flex; align-items: center; gap: 12px;">
        <div style="width: 24px; height: 1px; background: var(--color-gold-400);"></div>
        <span style="font-family: var(--font-body); font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-gold-600); font-weight: 500;">CRO-ES 7253</span>
        <div style="width: 24px; height: 1px; background: var(--color-gold-400);"></div>
      </div>

    </div>
  </div>
</section>
