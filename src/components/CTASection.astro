---
import { SITE } from "@data/site";

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  variant?: "rose" | "dark" | "light";
}

const {
  title = "Pronta para se transformar?",
  subtitle = "Agende agora e experimente o cuidado que você merece. Vagas limitadas — garanta a sua.",
  ctaText = "Agendar pelo WhatsApp",
  ctaHref = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`,
  variant = "rose",
} = Astro.props;

const backgrounds = {
  rose: "background: linear-gradient(135deg, var(--color-gold-500) 0%, var(--color-rose-600) 100%);",
  dark: "background: linear-gradient(135deg, var(--color-charcoal-900) 0%, var(--color-charcoal-700) 100%);",
  light: "background: linear-gradient(135deg, var(--color-cream-100) 0%, var(--color-nude-200) 100%);",
};

const textColor = variant === "light" ? "var(--color-charcoal-800)" : "white";
const subTextColor = variant === "light" ? "var(--color-charcoal-500)" : "rgba(255,255,255,0.8)";
---

<section
  class="py-20 relative overflow-hidden"
  style={backgrounds[variant]}
  aria-labelledby="cta-heading"
>
  <!-- Elementos decorativos de fundo -->
  <div
    class="absolute inset-0 opacity-10 pointer-events-none"
    aria-hidden="true"
    style="background-image: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.3) 0%, transparent 40%), radial-gradient(circle at 80% 50%, rgba(255,255,255,0.2) 0%, transparent 40%);"
  ></div>

  <div class="container-site text-center relative z-10">
    <div class="max-w-2xl mx-auto reveal">
      <!-- Decoração -->
      <div class="flex items-center justify-center gap-4 mb-8" aria-hidden="true">
        <div class="h-px w-12 opacity-40" style="background: white;"></div>
        <span class="text-xl opacity-60">✦</span>
        <div class="h-px w-12 opacity-40" style="background: white;"></div>
      </div>

      <h2
        id="cta-heading"
        class="font-serif mb-6"
        style={`color: ${textColor}; font-size: clamp(1.75rem, 4vw, 2.75rem);`}
      >
        {title}
      </h2>

      <p
        class="mb-10 text-lg"
        style={`color: ${subTextColor}; max-width: 500px; margin-inline: auto;`}
      >
        {subtitle}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={ctaHref}
          target={ctaHref.startsWith("http") ? "_blank" : "_self"}
          rel={ctaHref.startsWith("http") ? "noopener noreferrer" : undefined}
          class="inline-flex items-center gap-2.5 px-8 py-4 bg-white rounded-full font-medium text-base transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5"
          style="color: var(--color-gold-600);"
          aria-label={ctaText}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {ctaText}
        </a>

        <a
          href="/servicos"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-medium text-base transition-all duration-300 border"
          style={`color: ${textColor}; border-color: rgba(255,255,255,0.35); hover:border-color: rgba(255,255,255,0.7);`}
          aria-label="Ver serviços"
        >
          Ver serviços
        </a>
      </div>
    </div>
  </div>
</section>
