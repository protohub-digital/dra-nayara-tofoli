---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import FloatingWhatsApp from "@components/FloatingWhatsApp.astro";
import MapSection from "@components/MapSection.astro";
import { SITE } from "@data/site";
---

<Layout
  title="Contato"
  description={`Entre em contato com ${SITE.name}. Whatsapp, Instagram, formulário de contato e localização. ${SITE.address.city} — ${SITE.address.state}.`}
>
  <Navbar dark={true} />

  <main id="main-content" tabindex="-1">
    <!-- Hero -->
    <section
      class="pt-36 pb-20"
      style="background: linear-gradient(135deg, var(--color-charcoal-900) 0%, var(--color-charcoal-800) 100%);"
      aria-labelledby="contact-page-heading"
    >
      <div class="container-site text-center">
        <p class="section-label mb-4" style="color: var(--color-gold-400);">Fale conosco</p>
        <div class="divider-elegant mb-6"></div>
        <h1
          id="contact-page-heading"
          class="font-serif"
          style="color: white; font-size: clamp(2rem, 5vw, 4rem);"
        >
          Contato
        </h1>
        <p class="mt-4 max-w-md mx-auto" style="color: rgba(255,255,255,0.6);">
          Tire suas dúvidas, agende um horário ou simplesmente diga olá.
        </p>
      </div>
    </section>

    <!-- Contato principal -->
    <section class="section-padding" aria-label="Formas de contato">
      <div class="container-site">
        <div class="max-w-2xl mx-auto">

          <!-- Canais de contato -->
          <div class="reveal">
            <h2 class="font-serif text-2xl mb-8" style="color: var(--color-charcoal-800);">
              Canais de atendimento
            </h2>

            <!-- Cards de contato -->
            <div class="space-y-4 mb-10">
              <!-- WhatsApp -->
              <a
                href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="card-premium p-5 flex items-center gap-5 group no-underline"
                aria-label="Conversar pelo WhatsApp"
              >
                <div
                  class="w-14 h-14 rounded-2xl flex items-center justify-center text-white shrink-0 transition-transform duration-300 group-hover:scale-105"
                  style="background: linear-gradient(135deg, #25d366, #128c7e);"
                  aria-hidden="true"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <p class="font-medium" style="color: var(--color-charcoal-700);">WhatsApp</p>
                  <p class="text-sm" style="color: var(--color-charcoal-400);">
                    Resposta rápida — Respondo em minutos
                  </p>
                  <p class="text-sm font-medium mt-0.5" style="color: var(--color-gold-600);">
                    {SITE.schema.telephone}
                  </p>
                </div>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-charcoal-300);" class="group-hover:translate-x-1 transition-transform duration-200" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>

              <!-- Instagram -->
              <a
                href={SITE.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="card-premium p-5 flex items-center gap-5 group no-underline"
                aria-label="Ver perfil no Instagram"
              >
                <div
                  class="w-14 h-14 rounded-2xl flex items-center justify-center text-white shrink-0 transition-transform duration-300 group-hover:scale-105"
                  style="background: linear-gradient(135deg, #f58529, #dd2a7b, #8134af);"
                  aria-hidden="true"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <p class="font-medium" style="color: var(--color-charcoal-700);">Instagram</p>
                  <p class="text-sm" style="color: var(--color-charcoal-400);">
                    Acompanhe resultados e novidades
                  </p>
                  <p class="text-sm font-medium mt-0.5" style="color: var(--color-gold-600);">
                    {SITE.instagramHandle}
                  </p>
                </div>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-charcoal-300);" class="group-hover:translate-x-1 transition-transform duration-200" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>

              <!-- E-mail -->
              <a
                href={`mailto:${SITE.email}`}
                class="card-premium p-5 flex items-center gap-5 group no-underline"
                aria-label="Enviar e-mail"
              >
                <div
                  class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-105"
                  style="background: linear-gradient(135deg, var(--color-gold-500), var(--color-rose-500));"
                  aria-hidden="true"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <p class="font-medium" style="color: var(--color-charcoal-700);">E-mail</p>
                  <p class="text-sm" style="color: var(--color-charcoal-400);">Resposta em até 24h</p>
                  <p class="text-sm font-medium mt-0.5" style="color: var(--color-gold-600);">{SITE.email}</p>
                </div>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-charcoal-300);" class="group-hover:translate-x-1 transition-transform duration-200" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>

            <!-- Horários -->
            <div
              class="p-6 rounded-2xl"
              style="background: var(--color-cream-100); border: 1px solid var(--color-cream-300);"
              aria-label="Horários de atendimento"
            >
              <h3 class="font-serif text-lg mb-4" style="color: var(--color-charcoal-700);">
                🕐 Horários de atendimento
              </h3>
              <div class="space-y-2">
                {SITE.hours.map(({ day, time }) => (
                  <div class="flex justify-between text-sm py-1.5 border-b last:border-0" style="border-color: var(--color-cream-300);">
                    <span style="color: var(--color-charcoal-500);">{day}</span>
                    <span class="font-medium" style="color: var(--color-charcoal-700);">{time}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Mapa -->
    <MapSection />
  </main>

  <FloatingWhatsApp />
  <Footer />
</Layout>
