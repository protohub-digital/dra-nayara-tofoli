---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import FloatingWhatsApp from "@components/FloatingWhatsApp.astro";
import CTASection from "@components/CTASection.astro";
import { GALLERY_ITEMS, SITE } from "@data/site";

const categories = ["todos", ...new Set(GALLERY_ITEMS.map((i) => i.category))];
const categoryLabels: Record<string, string> = {
  todos: "Todos os Resultados",
  hof: "Harmonização Full Face",
  otomoldacao: "Otomoldação",
  facial: "Procedimentos Faciais",
};
---

<Layout
  title="Galeria"
  description="Resultados reais da Dra. Nayara Tofoli: harmonização facial, otomoldação, NT Lifting e mais. Antes e depois com autorização dos pacientes. Colatina, ES."
>
  <Navbar />

  <main id="main-content" tabindex="-1">
    <!-- Hero -->
    <section
      class="pt-36 pb-20"
      style="background: linear-gradient(135deg, var(--color-charcoal-900) 0%, var(--color-charcoal-800) 100%);"
      aria-labelledby="gallery-page-heading"
    >
      <div class="container-site text-center">
        <p class="section-label mb-4" style="color: var(--color-gold-400);">Portfólio</p>
        <div class="divider-elegant mb-6"></div>
        <h1
          id="gallery-page-heading"
          class="font-serif"
          style="color: white; font-size: clamp(2rem, 5vw, 4rem);"
        >
          Galeria de Transformações
        </h1>
        <p class="mt-4 max-w-md mx-auto" style="color: rgba(255,255,255,0.6);">
          Resultados reais de clientes reais. Cada trabalho é único, assim como você.
        </p>
      </div>
    </section>

    <!-- Galeria completa -->
    <section class="section-padding" aria-label="Galeria completa">
      <div class="container-site">
        <!-- Filtros -->
        <div
          class="flex flex-wrap justify-center gap-3 mb-12"
          role="group"
          aria-label="Filtrar galeria por categoria"
        >
          {categories.map((cat) => (
            <button
              class="filter-btn px-6 py-2.5 rounded-full text-sm font-medium transition-all duration-200"
              data-filter={cat}
              aria-pressed={cat === "todos"}
              style={
                cat === "todos"
                  ? "background: linear-gradient(135deg, var(--color-gold-500), var(--color-gold-600)); color: white; box-shadow: var(--shadow-gold);"
                  : "background: white; color: var(--color-charcoal-500); border: 1px solid var(--color-cream-300);"
              }
            >
              {categoryLabels[cat] || cat}
            </button>
          ))}
        </div>

        <!-- Grid principal -->
        <div
          id="gallery-grid"
          class="columns-2 md:columns-3 gap-4 space-y-4"
          role="list"
          aria-label="Galeria de trabalhos"
        >
          {GALLERY_ITEMS.map((item, index) => (
            <figure
              class="gallery-item group relative overflow-hidden cursor-pointer break-inside-avoid reveal"
              data-category={item.category}
              role="listitem"
              style={`animation-delay: ${index * 50}ms;`}
              tabindex="0"
              aria-label={item.alt}
            >
              <img
                src={item.src}
                alt={item.alt}
                class={`w-full object-cover object-top transition-transform duration-500 group-hover:scale-105 ${
                  index % 3 === 0 ? "aspect-[4/5]" : index % 3 === 1 ? "aspect-square" : "aspect-[3/4]"
                }`}
                style="display: block;"
                loading="lazy"
                decoding="async"
              />

              <!-- Overlay -->
              <figcaption
                class="absolute inset-0 flex flex-col justify-end p-5 opacity-0 group-hover:opacity-100 transition-all duration-300"
                style="background: linear-gradient(to top, rgba(28,28,30,0.8) 0%, transparent 55%);"
              >
                <p style="color: white; font-family: var(--font-body); font-size: 0.8rem; line-height: 1.4; margin-bottom: 0.25rem;">
                  {item.alt}
                </p>
                <p style="color: rgba(255,255,255,0.55); font-family: var(--font-body); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase;">
                  {categoryLabels[item.category] || item.category}
                </p>
              </figcaption>
            </figure>
          ))}
        </div>

        <!-- Nota sobre imagens reais -->
        <div
          class="mt-12 p-6 rounded-2xl text-center text-sm"
          style="background: var(--color-nude-50); border: 1px solid var(--color-nude-200); color: var(--color-charcoal-400);"
        >
          📸 Resultados individuais. Imagens com autorização dos pacientes. Mais resultados diariamente no
          <a
            href={SITE.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium hover:text-[--color-gold-600] transition-colors"
            style="color: var(--color-gold-500);"
            aria-label="Instagram da Dra. Nayara Tofoli"
          >
            Instagram {SITE.instagramHandle}
          </a>.
        </div>
      </div>
    </section>

    <!-- CTA -->
    <CTASection
      title="Quer fazer parte da nossa galeria?"
      subtitle="Agende seu procedimento e transforme sua beleza. Cada resultado é único e especial."
      ctaText="Agendar pelo WhatsApp"
    />
  </main>

  <FloatingWhatsApp />
  <Footer />
</Layout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const galleryItems = document.querySelectorAll<HTMLElement>(".gallery-item");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter || "todos";

      filterBtns.forEach((b) => {
        const isActive = b === btn;
        b.setAttribute("aria-pressed", String(isActive));
        if (isActive) {
          b.style.cssText = "background: linear-gradient(135deg, var(--color-gold-500), var(--color-gold-600)); color: white; box-shadow: var(--shadow-gold);";
        } else {
          b.style.cssText = "background: white; color: var(--color-charcoal-500); border: 1px solid var(--color-cream-300);";
        }
      });

      galleryItems.forEach((item) => {
        const cat = item.dataset.category || "";
        const visible = filter === "todos" || cat === filter;
        item.style.display = visible ? "" : "none";
      });
    });
  });
</script>
