---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import FloatingWhatsApp from "@components/FloatingWhatsApp.astro";
import CTASection from "@components/CTASection.astro";
import { ABOUT, SITE } from "@data/site";
---

<Layout
  title="Sobre a Dra. Nayara"
  description={`Conheça a trajetória de ${ABOUT.name}, cirurgiã-dentista especialista em harmonização facial e otomoldação em Colatina, ES. CRO-ES 7253 — referência estadual.`}
>
  <Navbar />

  <main id="main-content" tabindex="-1">
    <!-- Hero da página sobre -->
    <section
      class="pt-36 pb-20"
      style="background: linear-gradient(135deg, var(--color-charcoal-900) 0%, var(--color-charcoal-800) 100%);"
      aria-labelledby="about-page-heading"
    >
      <div class="container-site text-center">
        <p class="section-label mb-4" style="color: var(--color-gold-400);">Sobre mim</p>
        <div class="divider-elegant mb-6"></div>
        <h1
          id="about-page-heading"
          class="font-serif"
          style="color: white; font-size: clamp(2rem, 5vw, 4rem);"
        >
          {ABOUT.name}
        </h1>
        <p class="mt-3 text-lg" style="color: rgba(255,255,255,0.6);">{ABOUT.title}</p>
      </div>
    </section>

    <!-- Bio completa -->
    <section class="section-padding" aria-labelledby="bio-heading">
      <div class="container-site">
        <div class="grid gap-16 lg:grid-cols-2 items-start">

          <!-- Foto -->
          <div class="relative reveal">
            <div
              class="absolute -top-4 -left-4 w-full h-full rounded-3xl border-2 hidden lg:block"
              style="border-color: var(--color-gold-200); z-index: 0;"
              aria-hidden="true"
            ></div>
            <div
              class="relative z-10 rounded-3xl overflow-hidden aspect-[4/5]"
              role="img"
              aria-label={`Foto profissional de ${ABOUT.name}`}
            >
              <img
                src="/images/profile/profile.jpg"
                alt={`Foto profissional de ${ABOUT.name} — ${ABOUT.title}`}
                class="w-full h-full object-cover object-top"
                loading="eager"
                decoding="async"
              />
              <div
                class="absolute inset-0 flex items-end p-8"
                style="background: linear-gradient(to top, rgba(20,10,5,0.6), transparent);"
                aria-hidden="true"
              >
                <div>
                  <p style="color: white;" class="font-serif text-xl">{ABOUT.name}</p>
                  <p style="color: rgba(255,255,255,0.6);" class="text-sm">{ABOUT.title}</p>
                </div>
              </div>
            </div>

            <!-- Badge de satisfação -->
            <div
              class="absolute -bottom-6 -right-6 z-20 bg-white rounded-2xl p-5 text-center animate-float"
              style="box-shadow: var(--shadow-medium);"
              aria-label={`${ABOUT.satisfaction} de satisfação`}
            >
              <p class="font-serif text-3xl font-medium text-gradient">{ABOUT.satisfaction}</p>
              <p class="text-xs mt-0.5" style="color: var(--color-charcoal-400);">satisfação</p>
            </div>
          </div>

          <!-- Conteúdo -->
          <div class="reveal">
            <h2 id="bio-heading" class="font-serif mb-6" style="color: var(--color-charcoal-800);">
              Minha história
            </h2>

            <div class="space-y-4 mb-10">
              {ABOUT.bio.split("\n\n").filter(Boolean).map((para) => (
                <p style="color: var(--color-charcoal-500); line-height: 1.9;">
                  {para.trim()}
                </p>
              ))}
            </div>

            <!-- Missão e Visão -->
            <div class="grid gap-4 sm:grid-cols-2 mb-10">
              <div
                class="p-5 rounded-2xl"
                style="background: var(--color-nude-50); border: 1px solid var(--color-nude-200);"
              >
                <h3 class="font-serif text-lg mb-3" style="color: var(--color-charcoal-700);">
                  🌟 Missão
                </h3>
                <p class="text-sm leading-relaxed" style="color: var(--color-charcoal-500);">
                  {ABOUT.mission}
                </p>
              </div>
              <div
                class="p-5 rounded-2xl"
                style="background: var(--color-nude-50); border: 1px solid var(--color-nude-200);"
              >
                <h3 class="font-serif text-lg mb-3" style="color: var(--color-charcoal-700);">
                  🎯 Visão
                </h3>
                <p class="text-sm leading-relaxed" style="color: var(--color-charcoal-500);">
                  {ABOUT.vision}
                </p>
              </div>
            </div>

            <!-- Valores -->
            <div class="mb-10">
              <h3 class="font-serif text-lg mb-4" style="color: var(--color-charcoal-700);">
                Valores que me guiam
              </h3>
              <div class="flex flex-wrap gap-2">
                {ABOUT.values.map((value) => (
                  <span
                    class="px-4 py-2 rounded-full text-sm font-medium"
                    style="background: var(--color-nude-100); color: var(--color-gold-700); border: 1px solid var(--color-nude-300);"
                  >
                    {value}
                  </span>
                ))}
              </div>
            </div>

            <!-- CTA -->
            <a
              href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              Agendar Avaliação
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Estatísticas -->
    <section
      class="py-16"
      style="background: linear-gradient(135deg, var(--color-nude-50), var(--color-cream-200));"
      aria-labelledby="stats-heading"
    >
      <div class="container-site">
        <h2 id="stats-heading" class="sr-only">Estatísticas profissionais</h2>
        <div class="grid grid-cols-3 gap-8 text-center">
          {[
            { value: ABOUT.experience, label: "de experiência" },
            { value: ABOUT.clients, label: "clientes atendidas" },
            { value: ABOUT.satisfaction, label: "taxa de satisfação" },
          ].map(({ value, label }) => (
            <div class="reveal">
              <p class="font-serif text-4xl font-medium text-gradient mb-2">{value}</p>
              <p class="text-sm" style="color: var(--color-charcoal-400);">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Certificações -->
    <section class="section-padding" aria-labelledby="certifications-heading">
      <div class="container-site max-w-3xl mx-auto">
        <div class="text-center mb-12 reveal">
          <p class="section-label mb-4">Formação</p>
          <div class="divider-elegant mb-6"></div>
          <h2 id="certifications-heading" class="font-serif" style="color: var(--color-charcoal-800);">
            Certificações e<br />
            <em style="color: var(--color-gold-600);">especializações</em>
          </h2>
        </div>

        <div class="space-y-4 reveal">
          {ABOUT.certifications.map((cert, index) => (
            <div
              class="flex items-start gap-4 p-5 rounded-2xl"
              style="background: white; box-shadow: var(--shadow-soft);"
            >
              <div
                class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-semibold shrink-0 mt-0.5"
                style="background: linear-gradient(135deg, var(--color-gold-500), var(--color-rose-500));"
                aria-hidden="true"
              >
                {index + 1}
              </div>
              <p class="text-sm leading-relaxed pt-1" style="color: var(--color-charcoal-600);">
                {cert}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <CTASection
      title="Pronta para se conhecer melhor?"
      subtitle="Agende sua avaliação e descubra o tratamento ideal para você."
    />
  </main>

  <FloatingWhatsApp />
  <Footer />
</Layout>
